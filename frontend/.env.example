# ── Supabase (client-side, anon key — safe to expose) ────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ── Backend API base URL ──────────────────────────────────────────────────────
VITE_API_URL=https://nizam-platform-production.up.railway.app

# ── Widget script URL (where widget.js is served from — the backend origin) ──
# NOTE: widget.js is served by the Railway backend, not this Vercel deployment.
# Update this to your Railway backend URL so embed codes given to clients
# point to the correct host.
VITE_WIDGET_URL=https://nizam-platform-production.up.railway.app
