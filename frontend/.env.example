# ── Supabase (client-side, anon key — safe to expose) ────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ── Backend API base URL ──────────────────────────────────────────────────────
VITE_API_URL=https://nizam-platform-production.up.railway.app

# ── Widget script URL (where widget.js is served from) ───────────────────────
# widget.js is a static asset of THIS frontend (public/widget.js), so it is
# served from this deployment's own origin — NOT the Railway backend, which
# 404s /widget.js and sends Cross-Origin-Resource-Policy: same-origin, making
# the embed fail on a tenant's site. Only data-api points at the backend.
# OPTIONAL: leave unset to use the frontend's own origin (correct in
# production); set it only to override the host, e.g. a custom domain or CDN.
VITE_WIDGET_URL=https://nizam-platform.vercel.app
