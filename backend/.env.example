# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Frontend / CORS ───────────────────────────────────────────────────────────
# Production URL of the Vercel frontend (used in CORS allow-list and login links)
FRONTEND_URL=https://your-frontend.vercel.app
# Comma-separated extra origins to allow in CORS (e.g. local dev)
CORS_EXTRA_ORIGINS=http://localhost:8080

# ── Supabase (server-side, service role) ────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here   # SECRET — never commit

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...                                   # SECRET — never commit
# Model used for document embeddings
EMBEDDING_MODEL=text-embedding-ada-002

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...                            # SECRET — never commit

# ── Resend (transactional email) ──────────────────────────────────────────────
RESEND_API_KEY=re_...                                   # SECRET — never commit
# Verified sender address configured in your Resend account
RESEND_FROM_EMAIL=onboarding@resend.dev

# ── Support defaults (used when an org has no custom contact set) ─────────────
SUPPORT_DEFAULT_EMAIL=Alameenellice@gmail.com
SUPPORT_DEFAULT_PHONE=07033788353

# ── Widget ────────────────────────────────────────────────────────────────────
# Injected into widget.js at build time (see scripts/build-widget.mjs)
WIDGET_API_BASE=https://nizam-platform-production.up.railway.app

# ── Retell (voice AI) ─────────────────────────────────────────────────────────
RETELL_API_KEY=your_retell_key_here                     # SECRET — never commit

# ── Twilio ────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # SECRET — never commit
TWILIO_AUTH_TOKEN=your_twilio_auth_token                # SECRET — never commit

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...                           # SECRET — never commit
STRIPE_WEBHOOK_SECRET=whsec_...                         # SECRET — never commit
